generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                 String              @id @default(uuid())
  sessionId          String              @unique @map("session_id")
  name               String
  status             String              @default("disconnected")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  messages           Message[]
  reportSchedules    ReportSchedule[]
  reportCards        ReportCard[]
  users              User[]              @relation("UserSessions")
  excludedChats      ExcludedChat[]
  paymentExtractions PaymentExtraction[]
  broadcasts         Broadcast[]

  @@map("sessions")
}

model Message {
  id                 Int                 @id @default(autoincrement())
  sessionId          String              @map("session_id")
  sender             String
  receiver           String
  chatName           String?             @map("chat_name")
  messageBody        String              @map("message_body")
  isFromMe           Boolean             @map("is_from_me")
  mediaUrl           String?             @map("media_url")
  mediaType          String?             @map("media_type")
  authorId           String?             @map("author_id")
  authorName         String?             @map("author_name")
  isStatus           Boolean             @default(false) @map("is_status")
  timestamp          DateTime            @default(now())
  createdAt          DateTime            @default(now()) @map("created_at")
  session            Session             @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  paymentExtractions PaymentExtraction[]

  @@map("messages")
}

model User {
  id              String           @id @default(uuid())
  username        String           @unique
  password        String
  role            Role             @default(USER)
  profilePic      String?          @map("profile_pic")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  reportSchedules ReportSchedule[]
  backupSchedules BackupSchedule[]
  sessions        Session[]        @relation("UserSessions")
  issues          Issue[]          @relation("UserIssues")
  assignedTasks   Task[]           @relation("TaskPic")
  createdTasks    Task[]           @relation("TaskAssigner")

  @@map("users")
}

model ReportSchedule {
  id             String   @id @default(uuid())
  prompt         String
  period         String?
  sessionId      String?  @map("session_id")
  exportFormat   String   @default("pdf")
  targetWaNumber String   @map("target_wa_number")
  scheduleTime   String   @map("schedule_time")
  isActive       Boolean  @default(true) @map("is_active")
  scope          String   @default("device")
  targetChat     String?  @map("target_chat")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String   @map("created_by")
  name           String   @default("Laporan AI")
  user           User     @relation(fields: [createdBy], references: [id])
  session        Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@map("report_schedules")
}

enum Role {
  DEVELOPER
  ADMINISTRATOR
  USER
}

model ExcludedChat {
  id        String   @id @default(uuid())
  sessionId String?  @map("session_id")
  chatId    String   @map("chat_id")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  session   Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@unique([sessionId, chatId])
  @@map("excluded_chats")
}

model Dictionary {
  id         String   @id @default(uuid())
  term       String   @unique
  definition String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("dictionaries")
}

model BackupSchedule {
  id            String    @id @default(uuid())
  frequency     String    @default("daily") // daily, weekly, monthly
  backupTime    String    @map("backup_time") // HH:mm format (WIB)
  retentionDays Int       @default(30) @map("retention_days")
  isActive      Boolean   @default(true) @map("is_active")
  lastRunAt     DateTime? @map("last_run_at")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [createdBy], references: [id])

  @@map("backup_schedules")
}

model BackupLog {
  id           String   @id @default(uuid())
  filename     String
  fileSize     BigInt   @default(0) @map("file_size")
  status       String   @default("success") // success, failed
  type         String   @default("manual") // scheduled, manual, pre_writeoff
  errorMessage String?  @map("error_message")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("backup_logs")
}

model ReportCard {
  id            String    @id @default(uuid())
  sessionId     String    @map("session_id")
  type          String    @default("daily") // "daily" | "weekly"
  scope         String    @default("device") // "device" | "chat"
  contactNumber String?   @map("contact_number") // For per-chat scope
  contactName   String?   @map("contact_name") // Display name for per-chat
  date          DateTime // Date of the report (WIB)
  weekStart     DateTime? @map("week_start")
  weekEnd       DateTime? @map("week_end")

  overallGrade String @map("overall_grade") // A, A-, B+, B, B-, C+, C, C-, D, F
  overallScore Int    @map("overall_score") // 0-100

  scores       String // JSON: [{category, grade, score, description}]
  summary      String // Executive summary (Markdown)
  highlights   String? // Key highlights (Markdown)
  redFlags     String? @map("red_flags") // Anomalies & risks (Markdown)
  redFlagCount Int     @default(0) @map("red_flag_count")

  gallery String? // JSON: [{mediaUrl, caption, relatedSection}]

  totalMessages   Int @default(0) @map("total_messages")
  totalChats      Int @default(0) @map("total_chats")
  totalMediaFiles Int @default(0) @map("total_media_files")

  pdfUrl String? @map("pdf_url")

  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@unique([sessionId, type, scope, date, contactNumber])
  @@map("report_cards")
}

model PaymentExtraction {
  id              String   @id @default(uuid())
  sessionId       String?  @map("session_id")
  messageId       Int?     @map("message_id")
  pengirimPesan   String?  @map("pengirim_pesan")
  bankSumber      String?  @map("bank_sumber")
  tanggalTransfer String?  @map("tanggal_transfer")
  jenisTransaksi  String?  @map("jenis_transaksi")
  rekeningTujuan  String?  @map("rekening_tujuan")
  nominalTransfer Float?   @map("nominal_transfer")
  beritaPesan     String?  @map("berita_pesan")
  noReferensi     String?  @map("no_referensi")
  status          String?
  rawJson         String?  @map("raw_json")
  imageHash       String?  @map("image_hash")
  createdAt       DateTime @default(now()) @map("created_at")

  session Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@map("payment_extractions")
}

model OutstandingAr {
  id        Int       @id @default(autoincrement())
  tglpfi    DateTime?
  nopfi     String    @unique
  kdsls     String?
  nmsls     String?
  kdcust    String?
  nmcust    String?
  amount    Float?
  paid      Float?
  balance   Float?
  pdc       String?
  topid     Int?
  duedate   DateTime?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("outstandingar")
}

model Customer {
  id          Int       @id @default(autoincrement())
  kdcust      String    @unique
  nmcust      String?
  alamat      String?
  kontak      String?
  phone       String?
  status      String?
  first_sales DateTime?
  npwp        String?
  tax_name    String?
  tax_address String?
  nik         String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("customers")
}

model SyncSetting {
  id           String    @id @default(uuid())
  module       String    @unique // e.g., "outstandingar"
  moduleName   String    @map("module_name") // e.g., "Outstanding AR"
  endpoint     String
  authUsername String?   @map("auth_username")
  authPassword String?   @map("auth_password")
  scheduleType String    @default("manual") // "daily", "hourly", "minutely", "manual"
  syncType     String    @default("replace") // "replace", "upsert"
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("sync_settings")
}

model SyncLog {
  id           String   @id @default(uuid())
  module       String
  method       String // "AUTOMATIC", "MANUAL"
  status       String // "SUCCESS", "FAILED", "IN_PROGRESS"
  syncedRows   Int      @default(0) @map("synced_rows")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sync_logs")
}

model AnalisaCreditLimit {
  id               Int       @id @default(autoincrement())
  kunci            String    @unique
  kdcust           String?
  nmcust           String?
  kdsls            String?
  nmsls            String?
  old_cl           Float?
  newcl            Float?
  avgtrx           Float?
  oi               Int?
  pola_ontime      String?
  pola_cicil       String?
  kategori_ovd     String?
  kriteria_applied String?
  status_toko      String?
  channel          String?
  jumpfi           Int?
  bayar1x          Int?
  bayar2x          Int?
  bayar3x          Int?
  bayar4x          Int?
  ovdontime        Int?
  ovd3n10          Int?
  ovd11n18         Int?
  ovd19n30         Int?
  ovdmt30          Int?
  blmbayar         Int?
  baddebt          Int?
  old_top          Int?
  new_top          String?
  colovd           String?
  lasttrx          DateTime?
  pola             String?
  trgec            Int?
  status           String?
  outlet_type      String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("analisacreditlimit")
}

model PromptTemplate {
  id           Int      @id @default(autoincrement())
  category     String
  title        String
  type         String // 'TEXT' or 'FORM'
  formFields   Json? // e.g. [{ name: 'kodeSales', label: 'Kode Sales', type: 'text' }]
  templateText String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("prompt_templates")
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model ListAIModel {
  id            Int      @id @default(autoincrement())
  modelId       String   @unique @map("model_id")
  name          String
  badge         String?
  isFree        Boolean  @default(false) @map("is_free")
  contextLength Int?     @map("context_length")
  isActive      Boolean  @default(false) @map("is_active")
  isAvailable   Boolean  @default(true)
  isMultimodal  Boolean  @default(false) @map("is_multimodal")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("list_ai_models")
}

model Template {
  id         String      @id @default(uuid())
  name       String
  type       String // 'TEXT', 'STATIC_MEDIA', 'DYNAMIC_MEDIA'
  header     String?
  body       String
  footer     String?
  mediaUrl   String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  broadcasts Broadcast[]

  @@map("templates")
}

model Broadcast {
  id          String    @id @default(uuid())
  name        String
  templateId  String    @map("template_id")
  sessionId   String    @map("session_id")
  status      String    @default("PENDING") // 'PENDING', 'RUNNING', 'COMPLETED', 'FAILED'
  scheduledAt DateTime? @map("scheduled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  template   Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  session    Session              @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  recipients BroadcastRecipient[]

  @@map("broadcasts")
}

model BroadcastRecipient {
  id             String    @id @default(uuid())
  broadcastId    String    @map("broadcast_id")
  phoneNumber    String    @map("phone_number")
  variables      String? // JSON string for variables
  mediaUrl       String?   @map("media_url")
  status         String    @default("PENDING") // 'PENDING', 'SENT', 'FAILED'
  errorReason    String?   @map("error_reason")
  messageId      String?   @unique @map("message_id")
  deliveryStatus String?   @default("PENDING") @map("delivery_status")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@map("broadcast_recipients")
}

model ChatbotWhitelist {
  id          String   @id @default(uuid())
  phoneNumber String   @map("phone_number")
  name        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([phoneNumber])
  @@map("chatbot_whitelist")
}

model Persona {
  id           String    @id @default(uuid())
  name         String    @unique
  systemPrompt String    @db.Text
  toolAccess   String    @default("EXTERNAL") @map("tool_access")
  contacts     Contact[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("personas")
}

model Contact {
  id              String    @id @default(uuid())
  whatsappId      String    @unique @map("whatsapp_id")
  telegramId      String?   @unique @map("telegram_id")
  phoneNumber     String    @map("phone_number")
  realPhoneNumber String?   @map("real_phone_number")
  name            String
  group           String?
  isAllowed       Boolean   @default(false) @map("is_allowed")
  personaId       String?   @map("persona_id")
  kodeCustomer    String?   @map("kode_customer")
  kodeSales       String?   @map("kode_sales")
  kodeGudang      String?   @map("kode_gudang")
  botStatus       String    @default("BOT_ACTIVE") @map("bot_status")
  notes           String?   @db.Text
  strikeCount     Int       @default(0) @map("strike_count")
  ignoredUntil    DateTime? @map("ignored_until")
  persona         Persona?  @relation(fields: [personaId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("contacts")
}

model ProductKnowledge {
  id        String   @id @default(uuid())
  title     String
  fileType  String   @map("file_type")
  content   String   @db.Text
  mediaUrl  String?  @map("media_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_knowledge")
}

model BIReportCard {
  id          String   @id @default(uuid())
  type        String   @default("daily") // "daily" | "weekly" | "monthly"
  scope       String   @default("all") // "all" | "salesman" | "customer"
  scopeFilter String?  @map("scope_filter") // kdsls/kdcust value for filtered scope
  scopeName   String?  @map("scope_name") // nmsls/nmcust for display
  date        DateTime // Date of the report

  overallGrade String @map("overall_grade") // A, A-, B+, B, B-, C+, C, C-, D, F
  overallScore Int    @map("overall_score") // 0-100

  scores       String // JSON: [{category, grade, score, description}]
  summary      String // Executive summary (Markdown)
  highlights   String? // Key highlights (Markdown)
  redFlags     String? @map("red_flags") // Anomalies & risks (Markdown)
  redFlagCount Int     @default(0) @map("red_flag_count")

  // BI-specific stats
  totalAR        Float @default(0) @map("total_ar")
  totalPaid      Float @default(0) @map("total_paid")
  totalBalance   Float @default(0) @map("total_balance")
  totalCustomers Int   @default(0) @map("total_customers")
  totalInvoices  Int   @default(0) @map("total_invoices")
  overdueCount   Int   @default(0) @map("overdue_count")

  pdfUrl String? @map("pdf_url")

  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([type, scope, date, scopeFilter])
  @@map("bi_report_cards")
}

model DaftarHargaBarang {
  id              Int      @id @default(autoincrement())
  kdbrg           String   @unique
  nmbrg           String?
  pack_size       String?
  composite_desc  String?
  kdprinsip       String?
  principal_name1 String?
  nmsup           String?
  kpc1            Int?
  kpc2            Int?
  kpc3            Int?
  kpc4            Int?
  konversi1       Int?
  konversi2       Int?
  konversi3       Int?
  konversi4       Int?
  qtypcs          Int?
  uom1            String?
  uom2            String?
  uom3            String?
  uom4            String?
  lev             String?
  nmkat           String?
  nmsubkat        String?
  brand           String?
  tags            String?
  rbp1            Float?
  rbp2            Float?
  rbp3            Float?
  rbp4            Float?
  harga1          Float?
  harga2          Float?
  harga3          Float?
  harga4          Float?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("daftarhargabarang")
}

