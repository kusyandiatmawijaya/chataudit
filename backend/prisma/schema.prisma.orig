model LoyaltiEnesis {
  id     Int     @id @default(autoincrement())
  kdcust String?
  phone  String?
  u      Int?
  a_     String?
  a_w    String?
  b_     String?
  b_w    String?
  c_     String?
  c_w    String?
  d_     String?
  d_w    String?
  e_     String?
  e_w    String?
  f_     String?
  f_w    String?
  g_     String?
  g_w    String?
  h_     String?
  h_w    String?
  i_     String?
  i_w    String?
  j_     String?
  j_w    String?
  k_     String?
  k_w    String?
  l_     String?
