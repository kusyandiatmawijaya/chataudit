  @@map("loyaltienesis")
}

model Promo {
  id          String   @id @default(uuid())
  title       String
  description String
  keywords    String
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  imageUrl    String   @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("promos")
}

model TelegramBot {
  id        String   @id @default(uuid())
  token     String   @unique
  name      String?
  type      String   @default("MAIN") // "MAIN", "SOPIR", "SALESMAN"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("telegram_bots")
}

model Dashboard {
  id          String   @id @default(uuid())
  name        String // e.g., "Sales Performance", "Collection Dashboard"
  description String?
  isDefault   Boolean  @default(false)
  widgets     Widget[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("dashboards")
}

model Widget {
  id          String @id @default(uuid())
  dashboardId String
  title       String
  type        String // "KPI", "LINE_CHART", "BAR_CHART", "GEOMAP", "DATA_TABLE"
  dataSource  String // The identifier for the data endpoint (e.g., "SALES_COLLECTION_SUMMARY")
  configJson  Json // Stores specific settings (e.g., metrics to show, colors, target values)
  layoutJson  Json // Stores grid positions (x, y, w, h for react-grid-layout)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@map("widgets")
}

model DataSource {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  query         String   @db.Text
  widgetTypes   String // e.g. "[\"KPI\",\"LINE_CHART\",\"BAR_CHART\",\"DATA_TABLE\",\"GEOMAP\",\"DONUT_CHART\",\"AREA_CHART\"]"
  dynamicParams String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("data_sources")
}

model RasioPiutangPerSales {
  id              Int      @id @default(autoincrement())
  tahun           Int?
  bulan           Int?
  periode         String?
  jumlah_invoice  Int?
  jumlah_customer Int?
  kode_sales      String?
  nama_sales      String?
  divisi          String?
  jumlah_piutang  Float?
  jumlah_bayar    Float?
  jumlah_sisa     Float?
  rasio           Float?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("rasiopiutangpersales")
}

model Issue {
  id               String   @id @default(uuid())
  sourceModule     String   // e.g., "BUSINESS_ANALYST", "WA_CHAT_ANALYSIS"
  title            String
  queryParameters  Json     // The filters used (e.g., { division: 'Forisa', area: 'Depok' })
  initialSnapshot  Json     // The raw data/result at the time of creation
  aiSummary        String?  // The initial narrative from AI
  createdBy        String   // User ID
  createdAt        DateTime @default(now())
  tasks            Task[]

  user             User     @relation("UserIssues", fields: [createdBy], references: [id])

  @@map("issues")
}

model Task {
  id               String   @id @default(uuid())
  issueId          String
  picId            String   // Assignee User ID
  assignerId       String   // Assigner User ID
  deadline         DateTime
  status           String   @default("OPEN") // OPEN, SOLVE_AND_CLOSE, OPEN_CONTINUE, OPEN_CLOSE
  isAcknowledged   Boolean  @default(false) @map("is_acknowledged")
  picNotes         String?  @db.Text @map("pic_notes")
  currentSnapshot  Json?    // The latest pulled data for comparison
  aiProgressReport String?  // AI's analysis comparing initial vs current
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  issue            Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pic              User     @relation("TaskPic", fields: [picId], references: [id])
  assigner         User     @relation("TaskAssigner", fields: [assignerId], references: [id])

  @@map("tasks")
}
