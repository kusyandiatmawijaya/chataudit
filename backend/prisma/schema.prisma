  kpc3            Int?
  kpc4            Int?
  konversi1       Int?
  konversi2       Int?
  konversi3       Int?
  konversi4       Int?
  qtypcs          Int?
  uom1            String?
  uom2            String?
  uom3            String?
  uom4            String?
  lev             String?
  nmkat           String?
  nmsubkat        String?
  brand           String?
  tags            String?
  rbp1            Float?
  rbp2            Float?
  rbp3            Float?
  rbp4            Float?
  harga1          Float?
  harga2          Float?
  harga3          Float?
  harga4          Float?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
