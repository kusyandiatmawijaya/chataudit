}

model CustomDataSet {
  id          String          @id @default(uuid())
  slug        String          @unique // unique identifier, e.g. "delivery_logs"
  name        String          // Display name
  description String?
  schemaJson  Json?           @map("schema_json") // Optional field definitions
  rows        CustomDataRow[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("custom_data_sets")
}

model CustomDataRow {
  id        String        @id @default(uuid())
  datasetId String        @map("dataset_id")
  rowKey    String?       @map("row_key") // e.g. customer code, order id
  data      Json          // Arbitrary data payload
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  dataset   CustomDataSet @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([datasetId, rowKey])
  @@map("custom_data_rows")
}

model Promo {
  id          String   @id @default(uuid())
  title       String
  description String
  keywords    String
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  imageUrl    String   @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("promos")
}

model TelegramBot {
  id        String   @id @default(uuid())
  token     String   @unique
  name      String?
  type      String   @default("MAIN") // "MAIN", "SOPIR", "SALESMAN"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("telegram_bots")
}

model Dashboard {
  id          String   @id @default(uuid())
  name        String // e.g., "Sales Performance", "Collection Dashboard"
  description String?
  isDefault   Boolean  @default(false)
  widgets     Widget[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("dashboards")
}

model Widget {
  id          String @id @default(uuid())
  dashboardId String
  title       String
  type        String // "KPI", "LINE_CHART", "BAR_CHART", "GEOMAP", "DATA_TABLE"
  dataSource  String // The identifier for the data endpoint (e.g., "SALES_COLLECTION_SUMMARY")
  configJson  Json // Stores specific settings (e.g., metrics to show, colors, target values)
  layoutJson  Json // Stores grid positions (x, y, w, h for react-grid-layout)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@map("widgets")
}

model DataSource {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  query         String   @db.Text
  widgetTypes   String // e.g. "[\"KPI\",\"LINE_CHART\",\"BAR_CHART\",\"DATA_TABLE\",\"GEOMAP\",\"DONUT_CHART\",\"AREA_CHART\"]"
  dynamicParams String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("data_sources")
}

model RasioPiutangPerSales {
  id              Int      @id @default(autoincrement())
  tahun           Int?
  bulan           Int?
  periode         String?
  jumlah_invoice  Int?
  jumlah_customer Int?
  kode_sales      String?
  nama_sales      String?
  divisi          String?
  jumlah_piutang  Float?
  jumlah_bayar    Float?
  jumlah_sisa     Float?
  rasio           Float?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("rasiopiutangpersales")
}

model Issue {
  id               String   @id @default(uuid())
  sourceModule     String   // e.g., "BUSINESS_ANALYST", "WA_CHAT_ANALYSIS"
  title            String
  queryParameters  Json     // The filters used (e.g., { division: 'Forisa', area: 'Depok' })
  initialSnapshot  Json     // The raw data/result at the time of creation
  aiSummary        String?  // The initial narrative from AI
  createdBy        String   // User ID
  createdAt        DateTime @default(now())
  tasks            Task[]

  user             User     @relation("UserIssues", fields: [createdBy], references: [id])

  @@map("issues")
}

model Task {
  id               String   @id @default(uuid())
  issueId          String
  picId            String   // Assignee User ID
  assignerId       String   // Assigner User ID
  deadline         DateTime
  status           String   @default("OPEN") // OPEN, SOLVE_AND_CLOSE, OPEN_CONTINUE, OPEN_CLOSE
  isAcknowledged   Boolean  @default(false) @map("is_acknowledged")
  picNotes         String?  @db.Text @map("pic_notes")
  currentSnapshot  Json?    // The latest pulled data for comparison
  aiProgressReport String?  // AI's analysis comparing initial vs current
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  issue            Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pic              User     @relation("TaskPic", fields: [picId], references: [id])
  assigner         User     @relation("TaskAssigner", fields: [assignerId], references: [id])

  @@map("tasks")
}

model OrderableItem {
  id                      Int      @id @default(autoincrement())
  product_id              String
  product_name            String?
  brand_name              String?
  category                String?
  warehouse_location      String?
  total_available_pcs     Int?
  unit_1_name             String?
  unit_1_qty_per_pcs      Int?
  unit_1_available_stock  Int?
  unit_1_selling_price    Float?
  unit_2_name             String?
  unit_2_qty_per_pcs      Int?
  unit_2_available_stock  Int?
  unit_2_selling_price    Float?
  unit_3_name             String?
  unit_3_qty_per_pcs      Int?
  unit_3_available_stock  Int?
  unit_3_selling_price    Float?
  unit_4_name             String?
  unit_4_qty_per_pcs      Int?
  unit_4_available_stock  Int?
  unit_4_selling_price    Float?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("orderable_items")
}

// Temporary cart for ongoing conversation
model Cart {
  id          String   @id @default(uuid())
  contactId   String   @unique
  items       Json     // Array of { productId, qty, unit, unitPrice, subtotal }
  totalAmount Float    @default(0)
  updatedAt   DateTime @updatedAt
}

model SalesOrder {
  id            String            @id @default(uuid())
  so_number     String            @unique @map("so_number")
  kdcust        String            @map("kdcust")
  kdsls         String?           @map("kdsls")
  contactId     String?           @map("contact_id")
  order_date    DateTime          @default(now()) @map("order_date")
  total_amount  Float             @map("total_amount")
  status        String            @default("PENDING") // PENDING, PROCESSED, CANCELLED
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  items         SalesOrderItem[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id            String      @id @default(uuid())
  so_id         String      @map("so_id")
  product_id    String      @map("product_id")
  product_name  String?     @map("product_name")
  qty           Int
  unit          String?
  unit_price    Float       @map("unit_price")
  subtotal      Float
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  salesOrder    SalesOrder  @relation(fields: [so_id], references: [id], onDelete: Cascade)

  @@map("sales_order_items")
}

model ReturnTransaction {
  id              String   @id @default(uuid())
  returnNumber    String?  @unique @map("return_number")
  divisi          String?
  source          String?  @default("TELEGRAM_CHAT") // "TELEGRAM_CHAT" | "MINI_APP"
  telegramUserId  String?  @map("telegram_user_id")
  contactName     String?  @map("contact_name")
  customerCode    String?  @map("customer_code")
  customerName    String?  @map("customer_name")
  isCustomerValid Boolean  @default(false) @map("is_customer_valid")
  returnType      String   @map("return_type") // "TUNAI" or "KREDIT"
  latitude        Float?
  longitude       Float?
  locationAddress String?  @map("location_address") @db.Text
  photoUrl        String?  @map("photo_url")
  isPrinted       Boolean  @default(false) @map("is_printed")
  isDetailPrinted Boolean  @default(false) @map("is_detail_printed")
  isSynced        Boolean  @default(false) @map("is_synced")
  status          String   @default("DRAFT") @map("status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  invoiceNumber   String?  @map("invoice_number")
  salespersonCode String?  @map("salesperson_code")
  salespersonName String?  @map("salesperson_name")
  originLatitude        Float?   @map("origin_latitude")
  originLongitude       Float?   @map("origin_longitude")
  distanceDiff          Float?   @map("distance_diff")
  driverLatitude        Float?   @map("driver_latitude")
  driverLongitude       Float?   @map("driver_longitude")
  driverLocationAddress String?  @map("driver_location_address") @db.Text
  driverDistanceDiff    Float?   @map("driver_distance_diff")
  driverPhotoUrl        String?  @map("driver_photo_url")
  deletedAt             DateTime? @map("deleted_at")

  items           ReturnItem[]
  histories       ReturnHistory[]

  @@map("return_transactions")
}

model ReturnItem {
  id                    String            @id @default(uuid())
  returnTransactionId   String            @map("return_transaction_id")
  returnTransaction     ReturnTransaction @relation(fields: [returnTransactionId], references: [id], onDelete: Cascade)

  productCode   String?  @map("product_code")
  productName   String?  @map("product_name")
  uom           String?  // nilai UOM terpilih, e.g. "KRT", "LSN", "PCS"
  konversi      Int?     // konversi yang sesuai dengan UOM terpilih
  price         Float?   @map("price")
  totalPrice    Float?   @map("total_price")
  qty           Float?   @default(0)
  qtyGood       Float?   @map("qty_good")
  qtyBad        Float?   @map("qty_bad")
  originalQty   Float?   @map("original_qty")
  alasan        String?  @db.Text
  createdByGroup String? @map("created_by_group") // e.g., "SOPIR" or "GUDANG"
  deletedAt     DateTime? @map("deleted_at")

  createdAt     DateTime @default(now()) @map("created_at")

  @@map("return_items")
}

model PrintJob {
  id          String   @id @default(uuid())
  copies       Int      @default(1)
  base64_data  String?  @db.Text
  file_url     String?
  printer_name String?
  status       String   @default("PENDING") // PENDING, PRINTED, FAILED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("print_jobs")
}

model DailyDelivery {
  id                 Int       @id @default(autoincrement())
  delivery_number    String?   @map("delivery_number")
  delivery_date      DateTime? @map("delivery_date")
  invoice_number     String?   @map("invoice_number")
  customer_code      String?   @map("customer_code")
  customer_name      String?   @map("customer_name")
  salesperson_code   String?   @map("salesperson_code")
  salesperson_name   String?   @map("salesperson_name")
  warehouse_code     String?   @map("warehouse_code")
  latitude           Float?    @map("latitude")
  longitude          Float?    @map("longitude")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("daily_deliveries")
}

model GeneralReportSchedule {
  id              String   @id @default(uuid())
  name            String   @unique // e.g., "Salesman Monthly Report"
  reportId        String   @unique // e.g., "salesman_monthly"
  scheduleTime    String   @map("schedule_time") // e.g., "07:00"
  isActive        Boolean  @default(true) @map("is_active")
  senderSessionId String?  @map("sender_session_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("general_report_schedules")
}

model SalesCoverage {
  id                       Int      @id @default(autoincrement())
  salesman_code            String?  @map("salesman_code")
  salesman_name            String?  @map("salesman_name")
  customer_code            String?  @map("customer_code")
  customer_name            String?  @map("customer_name")
  full_store_address       String?  @map("full_store_address")
  visit_day                String?  @map("visit_day")
  visit_frequency          String?  @map("visit_frequency")
  store_operational_status String?  @map("store_operational_status")
  customer_phone           String?  @map("customer_phone")
  latitude                 Float?   @map("latitude")
  longitude                Float?   @map("longitude")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("sales_coverages")
}

model ReturnHistory {
  id                  String            @id @default(uuid())
  returnTransactionId String            @map("return_transaction_id")
  returnTransaction   ReturnTransaction @relation(fields: [returnTransactionId], references: [id], onDelete: Cascade)
  action              String   // e.g., 'CREATED', 'SPV_APPROVED', 'DRIVER_PROCESSED'
  actorRole           String?  @map("actor_role") // 'Salesman', 'Supervisor Sales', 'Driver/Kenek', 'Admin Gudang'
  actorName           String?  @map("actor_name")
  actorId             String?  @map("actor_id")
  changes             Json?    // Stores detailed changes made in this step
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("return_history")
}

model SaleableItem {
  id                    Int       @id @default(autoincrement())
  product_code          String?   @map("product_code")
  product_name          String?   @map("product_name")
  packaging_description String?   @map("packaging_description")
  principal_code        String?   @map("principal_code")
  principal_name        String?   @map("principal_name")
  brand_code            String?   @map("brand_code")
  brand_name            String?   @map("brand_name")
  salesman_code         String?   @map("salesman_code")
  salesman_name         String?   @map("salesman_name")
  price_tier_1          Float?    @map("price_tier_1")
  price_tier_2          Float?    @map("price_tier_2")
  price_tier_3          Float?    @map("price_tier_3")
  price_tier_4          Float?    @map("price_tier_4")
  price_tier_5          Float?    @map("price_tier_5")
  conversion_factor_1   Float?    @map("conversion_factor_1")
  conversion_factor_2   Float?    @map("conversion_factor_2")
  conversion_factor_3   Float?    @map("conversion_factor_3")
  unit_of_measure_1     String?   @map("unit_of_measure_1")
  unit_of_measure_2     String?   @map("unit_of_measure_2")
  unit_of_measure_3     String?   @map("unit_of_measure_3")
  pricing_level         String?   @map("pricing_level")
  product_barcode       String?   @map("product_barcode")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([product_code])
  @@index([salesman_code])
  @@index([salesman_name])
  @@index([principal_code])
  @@index([brand_code])
  @@map("saleable_items")
}
