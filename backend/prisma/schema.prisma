generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                 String              @id @default(uuid())
  sessionId          String              @unique @map("session_id")
  name               String
  status             String              @default("disconnected")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  messages           Message[]
  reportSchedules    ReportSchedule[]
  reportCards        ReportCard[]
  users              User[]              @relation("UserSessions")
  excludedChats      ExcludedChat[]
  paymentExtractions PaymentExtraction[]
  broadcasts         Broadcast[]

  @@map("sessions")
}

model Message {
  id                 Int                 @id @default(autoincrement())
  sessionId          String              @map("session_id")
  sender             String
  receiver           String
  chatName           String?             @map("chat_name")
  messageBody        String              @map("message_body")
  isFromMe           Boolean             @map("is_from_me")
  mediaUrl           String?             @map("media_url")
  mediaType          String?             @map("media_type")
  authorId           String?             @map("author_id")
  authorName         String?             @map("author_name")
  isStatus           Boolean             @default(false) @map("is_status")
  timestamp          DateTime            @default(now())
  createdAt          DateTime            @default(now()) @map("created_at")
  session            Session             @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  paymentExtractions PaymentExtraction[]

  @@map("messages")
}

model User {
  id              String           @id @default(uuid())
  username        String           @unique
  password        String
  role            Role             @default(USER)
  profilePic      String?          @map("profile_pic")
  whatsappId      String?          @map("whatsapp_id")
  phoneNumber     String?          @map("phone_number")
  telegramId      String?          @map("telegram_id")
  email           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  reportSchedules ReportSchedule[]
  backupSchedules BackupSchedule[]
  sessions        Session[]        @relation("UserSessions")
  issues          Issue[]          @relation("UserIssues")
  assignedTasks   Task[]           @relation("TaskPic")
  createdTasks    Task[]           @relation("TaskAssigner")

  @@map("users")
}

model ReportSchedule {
  id             String   @id @default(uuid())
  prompt         String
  period         String?
  sessionId      String?  @map("session_id")
  senderSessionId String? @map("sender_session_id")
  exportFormat   String   @default("pdf")
  targetWaNumber String   @map("target_wa_number")
  targetEmail    String?  @map("target_email")
  scheduleTime   String   @map("schedule_time")
  isActive       Boolean  @default(true) @map("is_active")
  scope          String   @default("device")
  targetChat     String?  @map("target_chat")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String   @map("created_by")
  name           String   @default("Laporan AI")
  user           User     @relation(fields: [createdBy], references: [id])
  session        Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@map("report_schedules")
}

enum Role {
  DEVELOPER
  ADMINISTRATOR
  USER
}

model ExcludedChat {
  id        String   @id @default(uuid())
  sessionId String?  @map("session_id")
  chatId    String   @map("chat_id")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  session   Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@unique([sessionId, chatId])
  @@map("excluded_chats")
}

model Dictionary {
  id         String   @id @default(uuid())
  term       String   @unique
  definition String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("dictionaries")
}

model BackupSchedule {
  id            String    @id @default(uuid())
  frequency     String    @default("daily") // daily, weekly, monthly
  backupTime    String    @map("backup_time") // HH:mm format (WIB)
  retentionDays Int       @default(30) @map("retention_days")
  isActive      Boolean   @default(true) @map("is_active")
  lastRunAt     DateTime? @map("last_run_at")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [createdBy], references: [id])

  @@map("backup_schedules")
}

model BackupLog {
  id           String   @id @default(uuid())
  filename     String
  fileSize     BigInt   @default(0) @map("file_size")
  status       String   @default("success") // success, failed
  type         String   @default("manual") // scheduled, manual, pre_writeoff
  errorMessage String?  @map("error_message")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("backup_logs")
}

model ReportCard {
  id            String    @id @default(uuid())
  sessionId     String    @map("session_id")
  type          String    @default("daily") // "daily" | "weekly"
  scope         String    @default("device") // "device" | "chat"
  contactNumber String?   @map("contact_number") // For per-chat scope
  contactName   String?   @map("contact_name") // Display name for per-chat
  date          DateTime // Date of the report (WIB)
  weekStart     DateTime? @map("week_start")
  weekEnd       DateTime? @map("week_end")

  overallGrade String @map("overall_grade") // A, A-, B+, B, B-, C+, C, C-, D, F
  overallScore Int    @map("overall_score") // 0-100

  scores       String // JSON: [{category, grade, score, description}]
  summary      String // Executive summary (Markdown)
  highlights   String? // Key highlights (Markdown)
  redFlags     String? @map("red_flags") // Anomalies & risks (Markdown)
  redFlagCount Int     @default(0) @map("red_flag_count")

  gallery String? // JSON: [{mediaUrl, caption, relatedSection}]

  totalMessages   Int @default(0) @map("total_messages")
  totalChats      Int @default(0) @map("total_chats")
  totalMediaFiles Int @default(0) @map("total_media_files")

  pdfUrl String? @map("pdf_url")

  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@unique([sessionId, type, scope, date, contactNumber])
  @@map("report_cards")
}

model PaymentExtraction {
  id              String   @id @default(uuid())
  sessionId       String?  @map("session_id")
  messageId       Int?     @map("message_id")
  pengirimPesan   String?  @map("pengirim_pesan")
  bankSumber      String?  @map("bank_sumber")
  tanggalTransfer String?  @map("tanggal_transfer")
  jenisTransaksi  String?  @map("jenis_transaksi")
  rekeningTujuan  String?  @map("rekening_tujuan")
  nominalTransfer Float?   @map("nominal_transfer")
  beritaPesan     String?  @map("berita_pesan")
  noReferensi     String?  @map("no_referensi")
  status          String?
  rawJson         String?  @map("raw_json")
  imageHash       String?  @map("image_hash")
  createdAt       DateTime @default(now()) @map("created_at")

  session Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@map("payment_extractions")
}

model OutstandingAr {
  id        Int       @id @default(autoincrement())
  tglpfi    DateTime?
  nopfi     String    @unique
  kdsls     String?
  nmsls     String?
  kdcust    String?
  nmcust    String?
  amount    Float?
  paid      Float?
  balance   Float?
  pdc       String?
  topid     Int?
  duedate   DateTime?
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("outstandingar")
}

model Customer {
  id           Int       @id @default(autoincrement())
  kdcust       String    @unique
  nmcust       String?
  alamat       String?
  kontak       String?
  phone        String?
  status       String?
  first_sales  DateTime?
  npwp         String?
  tax_name     String?
  tax_address  String?
  nik          String?
  latitude     Float?
  longitude    Float?
  customFields Json?     @map("custom_fields")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("customers")
}

model SyncSetting {
  id             String    @id @default(uuid())
  module         String    @unique // e.g., "customers", "outstandingar", "daftarhargabarang", or custom dataset
  moduleName     String    @map("module_name") // e.g., "Master Customer", "Outstanding AR"
  endpoint       String
  httpMethod     String    @default("GET") @map("http_method") // "GET", "POST"
  authType       String    @default("NONE") @map("auth_type") // "NONE", "BASIC", "BEARER", "API_KEY"
  authUsername   String?   @map("auth_username")
  authPassword   String?   @map("auth_password")
  authToken      String?   @map("auth_token")
  apiKeyHeader   String?   @map("api_key_header") // e.g. "X-API-Key"
  customHeaders  Json?     @map("custom_headers") // JSON object of custom headers
  paginationType String    @default("OFFSET_LIMIT") @map("pagination_type") // "NONE", "OFFSET_LIMIT", "PAGE_NUMBER"
  dataPath       String?   @map("data_path") // JSON path to items array, e.g. "items" or "data"
  fieldMapping   Json?     @map("field_mapping") // JSON mapping from API fields to DB fields
  scheduleType   String    @default("manual") // "manual", "hourly", "daily", etc.
  syncType       String    @default("replace") // "replace", "upsert", "push"
  isActive       Boolean   @default(true) @map("is_active")
  lastSyncAt     DateTime? @map("last_sync_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("sync_settings")
}

model SyncLog {
  id           String   @id @default(uuid())
  module       String
  method       String // "AUTOMATIC", "MANUAL"
  status       String // "SUCCESS", "FAILED", "IN_PROGRESS"
  syncedRows   Int      @default(0) @map("synced_rows")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sync_logs")
}

model AnalisaCreditLimit {
  id               Int       @id @default(autoincrement())
  kunci            String    @unique
  kdcust           String?
  nmcust           String?
  kdsls            String?
  nmsls            String?
  old_cl           Float?
  newcl            Float?
  avgtrx           Float?
  oi               Int?
  pola_ontime      String?
  pola_cicil       String?
  kategori_ovd     String?
  kriteria_applied String?
  status_toko      String?
  channel          String?
  jumpfi           Int?
  bayar1x          Int?
  bayar2x          Int?
  bayar3x          Int?
  bayar4x          Int?
  ovdontime        Int?
  ovd3n10          Int?
  ovd11n18         Int?
  ovd19n30         Int?
  ovdmt30          Int?
  blmbayar         Int?
  baddebt          Int?
  old_top          Int?
  new_top          String?
  colovd           String?
  lasttrx          DateTime?
  pola             String?
  trgec            Int?
  status           String?
  outlet_type      String?
  createdAt        DateTime  @default(now()) @map("created_at")
